{
  "openapi": "3.1.0",
  "info": {
    "title": "Jtag Boundary Scan Lockout Engine API",
    "description": "Rule-based classification of user-supplied JTAG/SWD-related telemetry. No physical hardware or fuse verification.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Server process healthy (no hardware status implied)"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Retrieve process-local counters as JSON",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate supplied telemetry under illustrative application thresholds",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based dossier with a reference to an in-memory HMAC-signed audit record"
          },
          "422": {
            "description": "Validation or identifier filtering failure"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic local reference response (not hardware interrogation)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve in-memory audit metadata and verify HMAC chain",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    }
  }
}
